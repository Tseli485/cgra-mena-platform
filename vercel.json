{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "pwa",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=()" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    { "source": "/manifest.json", "destination": "https://tseli485.github.io/cgra-mena-platform/manifest.json" },
    { "source": "/js/nl-fr-dict.js", "destination": "https://tseli485.github.io/cgra-mena-platform/js/nl-fr-dict.js" },
    { "source": "/js/bergamot-worker.js", "destination": "https://tseli485.github.io/cgra-mena-platform/js/bergamot-worker.js" },
    { "source": "/js/lib/:path*", "destination": "https://tseli485.github.io/cgra-mena-platform/js/lib/:path*" },
    { "source": "/models/:path*", "destination": "https://tseli485.github.io/cgra-mena-platform/models/:path*" },
    { "source": "/manual/:path*", "destination": "https://tseli485.github.io/cgra-mena-platform/manual/:path*" },
    { "source": "/icon-192.png", "destination": "https://tseli485.github.io/cgra-mena-platform/icon-192.png" },
    { "source": "/icon-512.png", "destination": "https://tseli485.github.io/cgra-mena-platform/icon-512.png" }
  ]
}
